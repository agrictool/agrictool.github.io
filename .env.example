# ─────────────────────────────────────────────────────────────────────────────
# RAISSAT Digital Food Systems Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (Spark free plan) ───────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# Note: VITE_FIREBASE_STORAGE_BUCKET is NOT needed — images use Cloudinary.

# ── Cloudinary (free image hosting — replaces Firebase Storage) ───────────────
# Get these from: cloudinary.com → Dashboard (Cloud Name)
#                 Settings → Upload → Upload presets → Add unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ── Local development ─────────────────────────────────────────────────────────
# Set to 'true' to use the Firebase Emulator Suite during local dev.
# Set to 'false' (or leave blank) for production.
VITE_USE_EMULATORS=false
