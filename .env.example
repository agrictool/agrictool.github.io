# Copy this file to .env.local and fill in your Firebase project values.
# .env.local is gitignored. NEVER commit real values to the repository.
# Firebase web config is not a secret, but security comes from Firestore rules + App Check.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Set to 'true' to use the Firebase Emulator Suite during local development
VITE_USE_EMULATORS=true
