rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Checks both the Firestore admins collection (Spark fallback)
      // and the custom claim (Blaze primary approach)
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isActive() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    function phaseIsOpen(phaseField) {
      return get(/databases/$(database)/documents/programmeSettings/current).data[phaseField] == 'open';
    }

    function isParticipant() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'participant';
    }

    // A brand-new public tool submission: pending only, size-limited, a Cloudinary image is required
    function validNewTool() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.toolName is string && d.toolName.size() > 0 && d.toolName.size() <= 200
        && d['function'] is string && d['function'].size() <= 500
        && d.category is string
        && d.toolType is string
        && d.costType in ['Free', 'Freemium', 'Premium']
        && !('approvedAt' in d)
        // An image or logo is compulsory, and must be hosted on our Cloudinary account
        && d.imageUrl is string
        && d.imageUrl.matches('https://res[.]cloudinary[.]com/.*');
    }

    // ── Public read-only settings ─────────────────────────────────────────────
    match /programmeSettings/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Registration is INVITATION-ONLY. The profile can only be created in the same atomic
      // transaction that (1) marks one unused invitation code as used and (2) adds exactly one
      // to the registration counter, which can never go above 60.
      allow create: if isOwner(uid) &&
        request.resource.data.role == 'participant' &&
        request.resource.data.accountStatus == 'active' &&
        !('contributorApproved' in request.resource.data) &&
        request.resource.data.gender in ['Male', 'Female'] &&
        request.resource.data.inviteCodeHash is string &&
        get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCodeHash)).data.used == false &&
        getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCodeHash)).data.used == true &&
        getAfter(/databases/$(database)/documents/registrationCounter/state).data.count ==
          get(/databases/$(database)/documents/registrationCounter/state).data.count + 1 &&
        getAfter(/databases/$(database)/documents/registrationCounter/state).data.count <= 60;
      allow update: if (
        // Participant can update limited fields only
        (isOwner(uid) && isActive() &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('participantId' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('accountStatus' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('uid' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('gender' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('inviteCodeHash' in request.resource.data.diff(resource.data).affectedKeys())
        ) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Invitation codes (registration is invitation-only, maximum 60) ─────────
    // Document ID = SHA-256 hash of the code. A visitor can look up ONE code by its hash (to
    // learn if it is valid/unused) but nobody can list them. Real codes are in inviteCodeSecrets.
    match /inviteCodes/{codeHash} {
      allow get: if true;
      allow list: if isAdmin();
      // Seeding by the administrator: only until the counter exists (i.e. before registration opens)
      allow create: if isAdmin() &&
        !exists(/databases/$(database)/documents/registrationCounter/state) &&
        request.resource.data.keys().hasOnly(['used', 'createdAt']) &&
        request.resource.data.used == false;
      // A code is consumed only by the new user's own registration transaction, exactly once
      allow update: if isSignedIn() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt']) &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCodeHash == codeHash;
      allow delete: if false;
    }

    // Readable codes: administrators only
    match /inviteCodeSecrets/{codeHash} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        !exists(/databases/$(database)/documents/registrationCounter/state) &&
        request.resource.data.keys().hasOnly(['code', 'createdAt']) &&
        request.resource.data.code.matches('[A-Z]{6}');
      allow update, delete: if false;
    }

    // Count of successful registrations. Starts at 0, can only go up by 1, never above 60.
    match /registrationCounter/state {
      allow get: if true;
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == 0;
      allow update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.count <= 60 &&
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if false;
    }

    // ── Admins collection (Spark fallback) ────────────────────────────────────
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Written only by bootstrap script via Admin SDK
    }

    // ── Participant ID reservation ────────────────────────────────────────────
    match /participantIds/{participantId} {
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/participantIds/$(participantId));
      allow read, update, delete: if isAdmin();
    }

    // ── Survey responses ──────────────────────────────────────────────────────
    match /surveyResponses/{responseId} {
      // Participant can read their own responses only
      // Decided from the document ID (uid_pre / uid_post), NOT resource.data, so that checking
      // for a response that does not exist yet returns "not found" instead of permission-denied.
      allow read: if isSignedIn() && (
        responseId == request.auth.uid + '_pre' ||
        responseId == request.auth.uid + '_post' ||
        isAdmin()
      );

      // Create: deterministic ID = uid_pre or uid_post, phase must be open, no existing response
      allow create: if isActive() && isParticipant() &&
        request.auth.uid == request.resource.data.userId &&
        !exists(/databases/$(database)/documents/surveyResponses/$(responseId)) &&
        (
          (responseId == request.auth.uid + '_pre' && phaseIsOpen('preSurveyState')) ||
          (responseId == request.auth.uid + '_post' && phaseIsOpen('postSurveyState'))
        ) &&
        request.resource.data.completionStatus == 'submitted';

      // Admin can update (for reopening) and delete
      allow update, delete: if isAdmin();
    }

    // ── Questionnaire schemas ─────────────────────────────────────────────────
    match /questionnaires/{type}/versions/{version} {
      allow read: if isSignedIn() || true; // Schemas are public (no personal data)
      allow write: if isAdmin();
    }

    // Answer keys are admin-only, never participant-readable
    match /answerKeys/{questionnaireId} {
      allow read, write: if isAdmin();
    }

    // ── Toolkit entries (public fields) ──────────────────────────────────────
    match /toolkitEntries/{toolId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      // Anyone can submit a PENDING tool; it stays invisible until an admin approves it.
      allow create: if isAdmin() || validNewTool();
      allow update, delete: if isAdmin();
    }

    // Toolkit private data (contributor PII, moderation notes)
    match /toolkitPrivate/{toolId} {
      // Contributor details can be written once by the submitter; only admins can read or change them.
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(
          ['contributorName', 'contributorOrg', 'contactEmail', 'moderationNote', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.moderationNote == null
        && request.resource.data.reviewedBy == null
      );
      allow read, update, delete: if isAdmin();
    }

    // Collaborating / contributing organisations shown on the public site
    match /collaborators/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Toolkit categories
    match /toolkitCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Contributor access codes ──────────────────────────────────────────────
    match /contributorAccess/{id} {
      allow read, write: if isAdmin();
      // Client never reads raw codes
    }

    // ── Certificates ─────────────────────────────────────────────────────────
    match /certificates/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Create: participant must have both surveys, cert phase open, no existing cert
      allow create: if isActive() && isOwner(uid) &&
        phaseIsOpen('certificatePhaseState') &&
        !exists(/databases/$(database)/documents/certificates/$(uid)) &&
        exists(/databases/$(database)/documents/surveyResponses/$(uid + '_pre')) &&
        exists(/databases/$(database)/documents/surveyResponses/$(uid + '_post')) &&
        request.resource.data.status == 'issued';
      allow update, delete: if isAdmin();
    }

    // ── Group challenge scores ────────────────────────────────────────────────
    match /groupChallengeScores/{scoreId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Admin audit logs ──────────────────────────────────────────────────────
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Append-only
    }
  }
}
