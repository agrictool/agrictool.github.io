// Firebase Storage is not used in this deployment.
// Images are hosted on Cloudinary (free tier).
// This file is kept as a placeholder. No Storage bucket is needed on the Spark plan.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
